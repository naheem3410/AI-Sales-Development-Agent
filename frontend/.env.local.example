# ─── Clerk Authentication ──────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk redirect URLs (used by Clerk components)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─── Feature flags ─────────────────────────────────────────────────────────────
# Polling interval in ms for pipeline status (default: 5000)
NEXT_PUBLIC_PIPELINE_POLL_INTERVAL=5000

# Polling interval in ms for onboarding (default: 3000)
NEXT_PUBLIC_ONBOARDING_POLL_INTERVAL=3000

# Max leads per page in the leads table (default: 25)
NEXT_PUBLIC_LEADS_PAGE_SIZE=25
